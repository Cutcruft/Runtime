{
  "name": "@cutcrft/plugin-sdk",
  "version": "0.1.0",
  "description": "CutCruft Plugin SDK — TypeScript API for building frontend plugins",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --external @cutcrft/runtime-client",
    "dev": "tsup src/index.ts --format esm,cjs --dts --external @cutcrft/runtime-client --watch"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "@cutcrft/runtime-client": "*"
  },
  "peerDependenciesMeta": {
    "vue": { "optional": false },
    "@cutcrft/runtime-client": { "optional": false }
  },
  "license": "MIT"
}
